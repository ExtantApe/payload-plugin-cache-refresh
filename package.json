{
  "name": "@extantape/payload-plugin-cache-refresh",
  "version": "0.1.0",
  "description": "Cache refresh for Payload: an admin button that refreshes the host's Next.js cache tags for the people the host allows, with a confirmation step, stale-while-revalidate by default, a targeted or full refresh, optional page warming and an audit hook.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "nextjs",
    "cache",
    "revalidate",
    "revalidatetag",
    "stale-while-revalidate",
    "admin"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExtantApe/payload-plugin-cache-refresh#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-cache-refresh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-cache-refresh.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "payload": "^3.80.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "graphql": "^16.14.2",
    "next": "16.4.4",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
